# Maintainer: marvic2409
pkgname=sway-nook
pkgver=0.1.0
pkgrel=1
pkgdesc='Native scratchpad shelf for Sway'
arch=('x86_64')
url='https://github.com/marvic2409/sway-nook'
license=('GPL-3.0-only')
depends=('sway' 'grim' 'gtk3' 'gtk-layer-shell' 'json-glib')
makedepends=('git' 'meson' 'ninja')
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP') # Git source is pinned to the release tag.

build() {
  meson setup build "$srcdir/$pkgname" --prefix=/usr --buildtype=release
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="$pkgdir" meson install -C build
}
